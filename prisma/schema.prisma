// Prisma schema for Knotix / Jewelcraft Rebuild
// Compatible with PostgreSQL (Neon PostgreSQL, Render, Supabase Postgres, Self-hosted)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  OUT_OF_STOCK
  ARCHIVED
}

enum UserRole {
  ADMIN
  CUSTOMER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  RAZORPAY
  COD
  UPI
  BANK_TRANSFER
}

enum CustomOrderStatus {
  REQUESTED
  DISCUSSING
  QUOTED
  ACCEPTED
  REJECTED
  COMPLETED
}

enum MessageStatus {
  NEW
  READ
  REPLIED
}

model Category {
  id          BigInt     @id @default(autoincrement())
  parentId    BigInt?    @map("parent_id")
  name        String     @db.VarChar(100)
  slug        String     @unique(map: "uq_categories_slug") @db.VarChar(120)
  description String?    @db.Text
  imageUrl    String?    @map("image_url") @db.VarChar(500)
  sortOrder   Int        @default(0) @map("sort_order")
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at")

  parent        Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  subCategories Category[] @relation("CategoryHierarchy")
  products      Product[]

  @@index([parentId], map: "idx_categories_parent")
  @@index([isActive], map: "idx_categories_active")
  @@index([sortOrder], map: "idx_categories_sort")
  @@map("categories")
}

model Product {
  id               BigInt         @id @default(autoincrement())
  categoryId       BigInt         @map("category_id")
  name             String         @db.VarChar(180)
  slug             String         @db.VarChar(220)
  sku              String?        @db.VarChar(100)
  shortDescription String?        @map("short_description") @db.VarChar(300)
  description      String?        @db.Text
  basePrice        Decimal        @map("base_price") @db.Decimal(10, 2)
  material         String?        @db.VarChar(100)
  craftType        String?        @map("craft_type") @db.VarChar(100)
  careInstructions String?        @map("care_instructions") @db.Text
  status           ProductStatus  @default(ACTIVE)
  featured         Boolean        @default(false) @map("is_featured")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at")

  category        Category         @relation(fields: [categoryId], references: [id])
  productVariants ProductVariant[]
  productImages   ProductImage[]
  wishlists       Wishlist[]
  productReviews  ProductReview[]
  orderItems      OrderItem[]

  @@index([categoryId], map: "idx_products_category")
  @@index([status], map: "idx_products_status")
  @@index([featured], map: "idx_products_featured")
  @@map("products")
}

model ProductVariant {
  id            BigInt         @id @default(autoincrement())
  productId     BigInt         @map("product_id")
  sku           String         @unique(map: "uq_variants_sku") @db.VarChar(80)
  variantName   String?        @map("variant_name") @db.VarChar(120)
  color         String?        @db.VarChar(60)
  size          String?        @db.VarChar(60)
  finish        String?        @db.VarChar(80)
  price         Decimal        @db.Decimal(10, 2)
  stockQuantity Int            @default(0) @map("stock_quantity")
  defaultVariant Boolean       @default(false) @map("is_default")
  active        Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at")

  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems     CartItem[]
  orderItems    OrderItem[]
  productImages ProductImage[]

  @@index([productId], map: "idx_variants_product")
  @@index([active], map: "idx_variants_active")
  @@map("product_variants")
}

model ProductImage {
  id           BigInt          @id @default(autoincrement())
  productId    BigInt          @map("product_id")
  variantId    BigInt?         @map("variant_id")
  imageUrl     String          @map("image_url") @db.VarChar(500)
  altText      String?         @map("alt_text") @db.VarChar(180)
  sortOrder    Int             @default(0) @map("sort_order")
  primaryImage Boolean         @default(false) @map("is_primary")
  createdAt    DateTime        @default(now()) @map("created_at")

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  productVariant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId], map: "idx_images_product")
  @@index([variantId], map: "idx_images_variant")
  @@index([productId, primaryImage], map: "idx_images_primary")
  @@map("product_images")
}

model User {
  id           BigInt      @id @default(autoincrement())
  fullName     String      @map("full_name") @db.VarChar(120)
  email        String      @unique(map: "uq_users_email") @db.VarChar(150)
  phone        String?     @db.VarChar(20)
  passwordHash String      @map("password_hash") @db.VarChar(255)
  role         UserRole    @default(CUSTOMER)
  active       Boolean     @default(true) @map("is_active")
  lastLoginAt  DateTime?   @map("last_login_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @default(now()) @updatedAt @map("updated_at")

  addresses           Address[]
  cart                Cart?
  orders              Order[]
  wishlists           Wishlist[]
  productReviews      ProductReview[]
  customOrderRequests CustomOrderRequest[]
  adminAuditLogs      AdminAuditLog[]

  @@index([role], map: "idx_users_role")
  @@index([active], map: "idx_users_active")
  @@map("users")
}

model Address {
  id           BigInt    @id @default(autoincrement())
  userId       BigInt    @map("user_id")
  fullName     String    @map("full_name") @db.VarChar(120)
  phone        String    @db.VarChar(20)
  addressLine1 String    @map("address_line1") @db.VarChar(255)
  addressLine2 String?   @map("address_line2") @db.VarChar(255)
  city         String    @db.VarChar(100)
  district     String?   @db.VarChar(100)
  state        String    @db.VarChar(100)
  postalCode   String    @map("postal_code") @db.VarChar(12)
  country      String    @default("India") @db.VarChar(80)
  defaultAddress Boolean @default(false) @map("is_default")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId], map: "idx_addresses_user")
  @@index([userId, defaultAddress], map: "idx_addresses_default")
  @@map("addresses")
}

model Cart {
  id        BigInt     @id @default(autoincrement())
  userId    BigInt     @unique(map: "uq_carts_user") @map("user_id")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  cartItems CartItem[]

  @@map("carts")
}

model CartItem {
  id               BigInt         @id @default(autoincrement())
  cartId           BigInt         @map("cart_id")
  variantId        BigInt         @map("variant_id")
  quantity         Int
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at")

  cart           Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId], map: "uq_cart_variant")
  @@index([cartId], map: "idx_cart_items_cart")
  @@index([variantId], map: "idx_cart_items_variant")
  @@map("cart_items")
}

model Order {
  id                  BigInt        @id @default(autoincrement())
  orderNo             String        @unique(map: "uq_orders_order_no") @map("order_no") @db.VarChar(40)
  userId              BigInt?       @map("user_id")
  addressId           BigInt?       @map("address_id")
  customerName        String        @map("customer_name") @db.VarChar(120)
  customerPhone       String        @map("customer_phone") @db.VarChar(20)
  customerEmail       String?       @map("customer_email") @db.VarChar(150)
  shippingAddressLine1 String       @map("shipping_address_line1") @db.VarChar(255)
  shippingAddressLine2 String?      @map("shipping_address_line2") @db.VarChar(255)
  shippingCity        String        @map("shipping_city") @db.VarChar(100)
  shippingState       String        @map("shipping_state") @db.VarChar(100)
  shippingPostalCode  String        @map("shipping_postal_code") @db.VarChar(12)
  shippingCountry     String        @default("India") @map("shipping_country") @db.VarChar(80)
  subtotal            Decimal       @db.Decimal(10, 2)
  shippingFee         Decimal       @map("shipping_fee") @db.Decimal(10, 2)
  discountAmount      Decimal       @map("discount_amount") @db.Decimal(10, 2)
  totalAmount         Decimal       @map("total_amount") @db.Decimal(10, 2)
  status              OrderStatus   @default(PENDING)
  paymentStatus       PaymentStatus @default(PENDING) @map("payment_status")
  notes               String?       @db.Text
  placedAt            DateTime      @default(now()) @map("placed_at")
  updatedAt           DateTime      @default(now()) @updatedAt @map("updated_at")

  user                User?                @relation(fields: [userId], references: [id])
  address             Address?             @relation(fields: [addressId], references: [id])
  orderItems          OrderItem[]
  payments            Payment[]
  productReviews      ProductReview[]
  customOrderRequests CustomOrderRequest[]

  @@index([userId], map: "idx_orders_user")
  @@index([status], map: "idx_orders_status")
  @@index([paymentStatus], map: "idx_orders_payment_status")
  @@index([placedAt], map: "idx_orders_placed_at")
  @@map("orders")
}

model OrderItem {
  id              BigInt          @id @default(autoincrement())
  orderId         BigInt          @map("order_id")
  productId       BigInt?         @map("product_id")
  variantId       BigInt?         @map("variant_id")
  productName     String          @map("product_name") @db.VarChar(180)
  sku             String?         @db.VarChar(80)
  variantDetails  String?         @map("variant_details") @db.VarChar(180)
  productImageUrl String?         @map("product_image_url") @db.VarChar(500)
  unitPrice       Decimal         @map("unit_price") @db.Decimal(10, 2)
  quantity        Int
  lineTotal       Decimal         @map("line_total") @db.Decimal(10, 2)

  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product?        @relation(fields: [productId], references: [id])
  productVariant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId], map: "idx_order_items_order")
  @@index([productId], map: "idx_order_items_product")
  @@index([variantId], map: "idx_order_items_variant")
  @@map("order_items")
}

model Payment {
  id              BigInt        @id @default(autoincrement())
  orderId         BigInt        @map("order_id")
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  amount          Decimal       @db.Decimal(10, 2)
  transactionId   String?       @unique(map: "uq_payments_transaction") @map("transaction_id") @db.VarChar(150)
  paymentGateway  String?       @map("payment_gateway") @db.VarChar(80)
  gatewayResponse String?       @map("gateway_response") @db.Text
  paidAt          DateTime?     @map("paid_at")
  createdAt       DateTime      @default(now()) @map("created_at")

  order           Order         @relation(fields: [orderId], references: [id])

  @@index([orderId], map: "idx_payments_order")
  @@index([status], map: "idx_payments_status")
  @@map("payments")
}

model Wishlist {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  productId BigInt   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId], map: "uq_wishlists_user_product")
  @@index([userId], map: "idx_wishlists_user")
  @@map("wishlists")
}

model ProductReview {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  productId BigInt   @map("product_id")
  orderId   BigInt?  @map("order_id")
  rating    Int
  title     String?  @db.VarChar(150)
  comment   String?  @db.Text
  approved  Boolean  @default(false) @map("is_approved")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  order   Order?   @relation(fields: [orderId], references: [id])

  @@unique([userId, productId], map: "uq_review_user_product")
  @@index([productId], map: "idx_reviews_product")
  @@index([approved], map: "idx_reviews_approved")
  @@map("product_reviews")
}

model CustomOrderRequest {
  id                BigInt            @id @default(autoincrement())
  userId            BigInt?           @map("user_id")
  name              String            @db.VarChar(120)
  phone             String            @db.VarChar(20)
  email             String?           @db.VarChar(150)
  title             String            @db.VarChar(180)
  description       String            @db.Text
  referenceImageUrl String?           @map("reference_image_url") @db.VarChar(500)
  budgetMin         Decimal?          @map("budget_min") @db.Decimal(10, 2)
  budgetMax         Decimal?          @map("budget_max") @db.Decimal(10, 2)
  quotedPrice       Decimal?          @map("quoted_price") @db.Decimal(10, 2)
  status            CustomOrderStatus @default(REQUESTED)
  convertedOrderId  BigInt?           @map("converted_order_id")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at")

  user           User?  @relation(fields: [userId], references: [id])
  convertedOrder Order? @relation(fields: [convertedOrderId], references: [id])

  @@index([userId], map: "idx_custom_user")
  @@index([status], map: "idx_custom_status")
  @@index([createdAt], map: "idx_custom_created")
  @@map("custom_order_requests")
}

model ContactMessage {
  id        BigInt        @id @default(autoincrement())
  name      String        @db.VarChar(120)
  email     String?       @db.VarChar(150)
  phone     String?       @db.VarChar(20)
  subject   String?       @db.VarChar(180)
  message   String        @db.Text
  status    MessageStatus @default(NEW)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @default(now()) @updatedAt @map("updated_at")

  @@index([status], map: "idx_contact_status")
  @@index([createdAt], map: "idx_contact_created")
  @@map("contact_messages")
}

model AdminAuditLog {
  id         BigInt   @id @default(autoincrement())
  adminId    BigInt?  @map("admin_id")
  action     String   @db.VarChar(80)
  entityType String   @map("entity_type") @db.VarChar(80)
  entityId   BigInt?  @map("entity_id")
  payload    String?  @db.Text
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at")

  admin User? @relation(fields: [adminId], references: [id])

  @@index([adminId], map: "idx_audit_admin")
  @@index([entityType, entityId], map: "idx_audit_entity")
  @@index([createdAt], map: "idx_audit_created")
  @@map("admin_audit_logs")
}
