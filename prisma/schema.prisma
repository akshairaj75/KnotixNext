generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id            BigInt     @id @default(autoincrement())
  isActive      Boolean    @default(true) @map("is_active")
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamp(6)
  description   String?
  imageUrl      String?    @map("image_url") @db.VarChar(500)
  name          String     @db.VarChar(100)
  slug          String     @unique(map: "uq_categories_slug") @db.VarChar(120)
  sortOrder     Int        @default(0) @map("sort_order")
  updatedAt     DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  parentId      BigInt?    @map("parent_id")
  parent        Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fksaok720gsu4u2wrgbk10b5n8d")
  subCategories Category[] @relation("CategoryHierarchy")
  products      Product[]

  @@index([parentId], map: "idx_categories_parent")
  @@index([isActive], map: "idx_categories_active")
  @@index([sortOrder], map: "idx_categories_sort")
  @@map("categories")
}

model Product {
  id               BigInt           @id @default(autoincrement())
  basePrice        Decimal          @map("base_price") @db.Decimal(10, 2)
  careInstructions String?          @map("care_instructions")
  craftType        String?          @map("craft_type") @db.VarChar(100)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamp(6)
  description      String?
  featured         Boolean          @default(false) @map("is_featured")
  material         String?          @db.VarChar(100)
  name             String           @db.VarChar(180)
  shortDescription String?          @map("short_description") @db.VarChar(300)
  sku              String?          @db.VarChar(100)
  slug             String           @db.VarChar(220)
  status           String           @default("ACTIVE") @db.VarChar(20)
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  categoryId       BigInt           @map("category_id")
  orderItems       OrderItem[]
  productImages    ProductImage[]
  productReviews   ProductReview[]
  productVariants  ProductVariant[]
  category         Category         @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fkog2rp4qthbtt2lfyhfo32lsw9")
  wishlists        Wishlist[]

  @@index([categoryId], map: "idx_products_category")
  @@index([status], map: "idx_products_status")
  @@index([featured], map: "idx_products_featured")
  @@map("products")
}

model ProductVariant {
  id             BigInt         @id @default(autoincrement())
  active         Boolean        @default(true) @map("is_active")
  color          String?        @db.VarChar(60)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamp(6)
  defaultVariant Boolean        @default(false) @map("is_default")
  finish         String?        @db.VarChar(80)
  price          Decimal        @db.Decimal(10, 2)
  size           String?        @db.VarChar(60)
  sku            String         @unique(map: "uq_variants_sku") @db.VarChar(80)
  stockQuantity  Int            @default(0) @map("stock_quantity")
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  variantName    String?        @map("variant_name") @db.VarChar(120)
  productId      BigInt         @map("product_id")
  cartItems      CartItem[]
  orderItems     OrderItem[]
  productImages  ProductImage[]
  product        Product        @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fkosqitn4s405cynmhb87lkvuau")

  @@index([productId], map: "idx_variants_product")
  @@index([active], map: "idx_variants_active")
  @@map("product_variants")
}

model ProductImage {
  id             BigInt          @id @default(autoincrement())
  altText        String?         @map("alt_text") @db.VarChar(180)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamp(6)
  imageUrl       String          @map("image_url") @db.VarChar(500)
  primaryImage   Boolean         @default(false) @map("is_primary")
  sortOrder      Int             @default(0) @map("sort_order")
  productId      BigInt          @map("product_id")
  variantId      BigInt?         @map("variant_id")
  product        Product         @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fkqnq71xsohugpqwf3c9gxmsuy")
  productVariant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fkqnqjv00ocaxfmu2k6b99ycdad")

  @@index([productId], map: "idx_images_product")
  @@index([variantId], map: "idx_images_variant")
  @@index([productId, primaryImage], map: "idx_images_primary")
  @@map("product_images")
}

model User {
  id                  BigInt               @id @default(autoincrement())
  active              Boolean              @default(true) @map("is_active")
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamp(6)
  email               String               @unique(map: "uq_users_email") @db.VarChar(150)
  fullName            String               @map("full_name") @db.VarChar(120)
  lastLoginAt         DateTime?            @map("last_login_at") @db.Timestamp(6)
  passwordHash        String               @map("password_hash") @db.VarChar(255)
  phone               String?              @db.VarChar(20)
  role                String               @default("CUSTOMER") @db.VarChar(20)
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  addresses           Address[]
  adminAuditLogs      AdminAuditLog[]
  cart                Cart?
  customOrderRequests CustomOrderRequest[]
  orders              Order[]
  productReviews      ProductReview[]
  wishlists           Wishlist[]

  @@index([role], map: "idx_users_role")
  @@index([active], map: "idx_users_active")
  @@map("users")
}

model Address {
  id             BigInt   @id @default(autoincrement())
  addressLine1   String   @map("address_line1") @db.VarChar(255)
  addressLine2   String?  @map("address_line2") @db.VarChar(255)
  city           String   @db.VarChar(100)
  country        String   @default("India") @db.VarChar(80)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  defaultAddress Boolean  @default(false) @map("is_default")
  district       String?  @db.VarChar(100)
  fullName       String   @map("full_name") @db.VarChar(120)
  phone          String   @db.VarChar(20)
  postalCode     String   @map("postal_code") @db.VarChar(12)
  state          String   @db.VarChar(100)
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  userId         BigInt   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk1fa36y2oqhao3wgg2rw1pi459")
  orders         Order[]

  @@index([userId], map: "idx_addresses_user")
  @@index([userId, defaultAddress], map: "idx_addresses_default")
  @@map("addresses")
}

model Cart {
  id        BigInt     @id @default(autoincrement())
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  userId    BigInt     @unique(map: "uq_carts_user") @map("user_id")
  cartItems CartItem[]
  user      User       @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fkb5o626f86h46m4s7ms6ginnop")

  @@map("carts")
}

model CartItem {
  id             BigInt         @id @default(autoincrement())
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamp(6)
  quantity       Int
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  cartId         BigInt         @map("cart_id")
  variantId      BigInt         @map("variant_id")
  productVariant ProductVariant @relation(fields: [variantId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk5yyw1o0dor9gmxfra1dqvn4qa")
  cart           Cart           @relation(fields: [cartId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fkpcttvuq4mxppo8sxggjtn5i2c")

  @@unique([cartId, variantId], map: "uq_cart_variant")
  @@index([cartId], map: "idx_cart_items_cart")
  @@index([variantId], map: "idx_cart_items_variant")
  @@map("cart_items")
}

model Order {
  id                   BigInt               @id @default(autoincrement())
  customerEmail        String?              @map("customer_email") @db.VarChar(150)
  customerName         String               @map("customer_name") @db.VarChar(120)
  customerPhone        String               @map("customer_phone") @db.VarChar(20)
  discountAmount       Decimal              @default(0) @map("discount_amount") @db.Decimal(10, 2)
  notes                String?
  orderNo              String               @unique(map: "uq_orders_order_no") @map("order_no") @db.VarChar(40)
  paymentStatus        String               @default("PENDING") @map("payment_status") @db.VarChar(20)
  placedAt             DateTime             @default(now()) @map("placed_at") @db.Timestamp(6)
  shippingAddressLine1 String               @map("shipping_address_line1") @db.VarChar(255)
  shippingAddressLine2 String?              @map("shipping_address_line2") @db.VarChar(255)
  shippingCity         String               @map("shipping_city") @db.VarChar(100)
  shippingCountry      String               @default("India") @map("shipping_country") @db.VarChar(80)
  shippingFee          Decimal              @default(0) @map("shipping_fee") @db.Decimal(10, 2)
  shippingPostalCode   String               @map("shipping_postal_code") @db.VarChar(12)
  shippingState        String               @map("shipping_state") @db.VarChar(100)
  status               String               @default("PENDING") @db.VarChar(20)
  subtotal             Decimal              @db.Decimal(10, 2)
  totalAmount          Decimal              @map("total_amount") @db.Decimal(10, 2)
  updatedAt            DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  addressId            BigInt?              @map("address_id")
  userId               BigInt?              @map("user_id")
  customOrderRequests  CustomOrderRequest[]
  orderItems           OrderItem[]
  user                 User?                @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk32ql8ubntj5uh44ph9659tiih")
  address              Address?             @relation(fields: [addressId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fkhlglkvf5i60dv6dn397ethgpt")
  payments             Payment[]
  productReviews       ProductReview[]

  @@index([userId], map: "idx_orders_user")
  @@index([status], map: "idx_orders_status")
  @@index([paymentStatus], map: "idx_orders_payment_status")
  @@index([placedAt], map: "idx_orders_placed_at")
  @@map("orders")
}

model OrderItem {
  id              BigInt          @id @default(autoincrement())
  lineTotal       Decimal         @map("line_total") @db.Decimal(10, 2)
  productImageUrl String?         @map("product_image_url") @db.VarChar(500)
  productName     String          @map("product_name") @db.VarChar(180)
  quantity        Int
  sku             String?         @db.VarChar(80)
  unitPrice       Decimal         @map("unit_price") @db.Decimal(10, 2)
  variantDetails  String?         @map("variant_details") @db.VarChar(180)
  orderId         BigInt          @map("order_id")
  productId       BigInt?         @map("product_id")
  variantId       BigInt?         @map("variant_id")
  order           Order           @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fkbioxgbv59vetrxe0ejfubep1w")
  productVariant  ProductVariant? @relation(fields: [variantId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fkemq71edpbn9wsxnxncfn1algp")
  product         Product?        @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fkocimc7dtr037rh4ls4l95nlfi")

  @@index([orderId], map: "idx_order_items_order")
  @@index([productId], map: "idx_order_items_product")
  @@index([variantId], map: "idx_order_items_variant")
  @@map("order_items")
}

model Payment {
  id              BigInt    @id @default(autoincrement())
  amount          Decimal   @db.Decimal(10, 2)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  gatewayResponse Json?     @map("gateway_response") @db.Json
  method          String    @db.VarChar(20)
  paidAt          DateTime? @map("paid_at") @db.Timestamp(6)
  paymentGateway  String?   @map("payment_gateway") @db.VarChar(80)
  status          String    @default("PENDING") @db.VarChar(20)
  transactionId   String?   @unique(map: "uq_payments_transaction") @map("transaction_id") @db.VarChar(150)
  orderId         BigInt    @map("order_id")
  order           Order     @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk81gagumt0r8y3rmudcgpbk42l")

  @@index([orderId], map: "idx_payments_order")
  @@index([status], map: "idx_payments_status")
  @@map("payments")
}

model Wishlist {
  id        BigInt   @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  productId BigInt   @map("product_id")
  userId    BigInt   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk330pyw2el06fn5g28ypyljt16")
  product   Product  @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fkl7ao98u2bm8nijc1rv4jobcrx")

  @@unique([userId, productId], map: "uq_wishlists_user_product")
  @@index([userId], map: "idx_wishlists_user")
  @@map("wishlists")
}

model ProductReview {
  id        BigInt   @id @default(autoincrement())
  approved  Boolean  @default(false) @map("is_approved")
  comment   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  rating    Int
  title     String?  @db.VarChar(150)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  orderId   BigInt?  @map("order_id")
  productId BigInt   @map("product_id")
  userId    BigInt   @map("user_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk35kxxqe2g9r4mww80w9e3tnw9")
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk58i39bhws2hss3tbcvdmrm60f")
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fkkpu8o8nqopc4lcqcfnnlpq5vg")

  @@unique([userId, productId], map: "uq_review_user_product")
  @@index([productId], map: "idx_reviews_product")
  @@index([approved], map: "idx_reviews_approved")
  @@map("product_reviews")
}

model CustomOrderRequest {
  id                BigInt   @id @default(autoincrement())
  budgetMax         Decimal? @map("budget_max") @db.Decimal(10, 2)
  budgetMin         Decimal? @map("budget_min") @db.Decimal(10, 2)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  description       String
  email             String?  @db.VarChar(150)
  name              String   @db.VarChar(120)
  phone             String   @db.VarChar(20)
  quotedPrice       Decimal? @map("quoted_price") @db.Decimal(10, 2)
  referenceImageUrl String?  @map("reference_image_url") @db.VarChar(500)
  status            String   @default("REQUESTED") @db.VarChar(20)
  title             String   @db.VarChar(180)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  convertedOrderId  BigInt?  @map("converted_order_id")
  userId            BigInt?  @map("user_id")
  user              User?    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk4cy52gryry5419rgfb8keo58h")
  convertedOrder    Order?   @relation(fields: [convertedOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fkwxh213l8248qeda46bl7nqw2")

  @@index([userId], map: "idx_custom_user")
  @@index([status], map: "idx_custom_status")
  @@index([createdAt], map: "idx_custom_created")
  @@map("custom_order_requests")
}

model ContactMessage {
  id        BigInt   @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  email     String?  @db.VarChar(150)
  message   String
  name      String   @db.VarChar(120)
  phone     String?  @db.VarChar(20)
  status    String   @default("NEW") @db.VarChar(20)
  subject   String?  @db.VarChar(180)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([status], map: "idx_contact_status")
  @@index([createdAt], map: "idx_contact_created")
  @@map("contact_messages")
}

model AdminAuditLog {
  id         BigInt   @id @default(autoincrement())
  action     String   @db.VarChar(80)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  entityId   BigInt?  @map("entity_id")
  entityType String   @map("entity_type") @db.VarChar(80)
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  payload    Json?    @db.Json
  adminId    BigInt?  @map("admin_id")
  admin      User?    @relation(fields: [adminId], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fkd4sj4j7mico8tb4e4rnvcdwd6")

  @@index([adminId], map: "idx_audit_admin")
  @@index([entityType, entityId], map: "idx_audit_entity")
  @@index([createdAt], map: "idx_audit_created")
  @@map("admin_audit_logs")
}
